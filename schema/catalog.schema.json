{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rosalind-science-showcases/catalog.schema.json",
  "title": "Rosalind Science Showcase Catalogue",
  "type": "object",
  "required": ["catalog_version", "updated", "plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "updated": {"type": "string", "format": "date"},
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "kind", "readme", "showcases"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "kind": {"enum": ["research-skill-bundle", "interactive-viewer", "workflow-workbench", "research-launcher"]},
          "readme": {"type": "string", "pattern": "^showcases/.+/README\\.md$"},
          "showcases": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/showcase"}
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "showcase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "status", "summary", "next_step", "case_path", "preview",
        "domain", "case_type", "difficulty", "evidence_level", "capabilities",
        "rosalind_tasks", "execution"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "prepared", "running", "ready", "blocked", "retired"]},
        "summary": {"type": "string", "minLength": 1},
        "next_step": {"type": "string", "minLength": 1},
        "case_path": {"type": "string", "pattern": "^showcases/.+/cases/.+$"},
        "preview": {"type": "string", "pattern": "^showcases/.+/cases/.+/previews/.+$"},
        "domain": {"$ref": "#/$defs/slug"},
        "case_type": {"enum": ["interface", "analysis", "workflow", "render", "export", "recovery"]},
        "difficulty": {"enum": ["beginner", "intermediate", "advanced"]},
        "evidence_level": {"enum": ["interface-observation", "computed-result", "multi-tool-result"]},
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:[_-][a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "rosalind_tasks": {
          "type": "array",
          "items": {"$ref": "#/$defs/slug"},
          "uniqueItems": true
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actual_tools", "device", "implementation", "status"],
          "properties": {
            "actual_tools": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "device": {"type": "string", "minLength": 1},
            "implementation": {"type": "string", "minLength": 1},
            "status": {"enum": ["documented", "verified"]}
          }
        }
      }
    }
  }
}
